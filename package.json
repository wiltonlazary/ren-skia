{
  "name": "ren-skia",
  "version": "0.1.7",
  "description": "The Skia (CanvasKit) renderer for ren-core: ren-canv's engine (retained scene, layout, text, hit testing, damage repaint, native text entry, accessibility mirror) replayed on a CanvasKit surface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiltonlazary/ren-skia.git"
  },
  "homepage": "https://github.com/wiltonlazary/ren-skia#readme",
  "bugs": {
    "url": "https://github.com/wiltonlazary/ren-skia/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "src",
    "types",
    "assets",
    "README.md"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./font.ttf": "./assets/font.ttf",
    "./mono.ttf": "./assets/mono.ttf"
  },
  "scripts": {
    "types": "node scripts/types.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node scripts/types.mjs && tsc -p tsconfig.json && tsc -p test/types/tsconfig.json && node --import ren-core/loader --test test/*.test.js test/*.test.jsx && node --import ren-core/compiled --test test/*.test.jsx",
    "prepare": "node scripts/types.mjs",
    "prepack": "node scripts/types.mjs"
  },
  "dependencies": {
    "ren-canv": "file:../../../ren-canv/wtree/_repo_",
    "ren-core": "file:../../../ren-core/wtree/_repo_"
  },
  "peerDependencies": {
    "canvaskit-wasm": "0.40.0"
  },
  "devDependencies": {
    "canvaskit-wasm": "0.40.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "ren-dom": "file:../../../ren-dom/wtree/_repo_",
    "rrx-core": "file:../../../rrx-core/wtree/_repo_",
    "typescript": "7.0.2"
  }
}
